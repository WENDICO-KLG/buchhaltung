# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase publishable/anon key. Never expose the service_role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Local application URL. Add this URL to the Supabase Auth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public VAPID key for browser push subscriptions. See SUPABASE_PUSH_SETUP.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
